<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 
      Cross-platform Docker grading CLI (dockergrade, list, validate commands)
      Works on any platform with Docker installed (Linux/macOS/Windows)
    -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Network packet capture libraries (cross-platform via libpcap on Linux/macOS) -->
    <PackageReference Include="EPPlus" Version="8.3.1" />
    <PackageReference Include="PacketDotNet" Version="1.4.8" />
    <PackageReference Include="SharpPcap" Version="6.3.1" />
    <!-- Excel file handling using ClosedXML (OpenPyXL-like for .NET) -->
    <!-- Using version 0.105.0 to match SolutionGrader.Core and avoid DocumentFormat.OpenXml version conflicts -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />
  </ItemGroup>
  
  <!-- Cross-platform references (both targets) -->
  <ItemGroup>
    <!-- Docker command execution support -->
    <ProjectReference Include="..\..\Lib\EnvironmentBuilder\EnvironmentBuilder.csproj" />
    <!-- Domain entities for environment configuration -->
    <ProjectReference Include="..\..\Lib\Domain\Domain.csproj" />

    <!-- Network monitoring for packet capture (cross-platform via libpcap) -->
    <ProjectReference Include="..\..\Lib\NetworkMonitor\NetworkMonitor.csproj" />
    <!-- Core grading services from Lib folder - now cross-platform -->
    <ProjectReference Include="..\..\Lib\SolutionGrader.Core\SolutionGrader.Core.csproj" />
    <!-- FileMaster for zip extraction when solution folder is missing -->
    <ProjectReference Include="..\..\Lib\FileMaster\FileMaster.csproj" />
  </ItemGroup>
</Project>
