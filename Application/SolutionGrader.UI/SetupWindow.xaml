<Window x:Class="SolutionGrader.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Auto Grading System - Setup" 
        Height="680" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="550" MinWidth="700">
    
    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="20">
            <StackPanel>
                <TextBlock Text="Auto Grading System" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="White"/>
                <TextBlock Text="Setup Configuration" 
                           FontSize="14" 
                           Foreground="#CCCCCC"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Configuration Form -->
        <Grid Grid.Row="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Submit Folder -->
            <TextBlock Grid.Row="0" Grid.Column="0" 
                       Text="Submit Folder:" 
                       VerticalAlignment="Center" 
                       FontWeight="SemiBold"/>
            <TextBox Grid.Row="0" Grid.Column="1" 
                     x:Name="txtSubmitFolder"
                     Style="{StaticResource InputTextBox}"
                     IsReadOnly="True"/>
            <Button Grid.Row="0" Grid.Column="2" 
                    Content="Browse..." 
                    Style="{StaticResource BrowseButton}"
                    Click="BrowseSubmitFolder_Click"/>
            
            <!-- Test Kit Folder -->
            <TextBlock Grid.Row="2" Grid.Column="0" 
                       Text="Test Kit Folder:" 
                       VerticalAlignment="Center" 
                       FontWeight="SemiBold"/>
            <TextBox Grid.Row="2" Grid.Column="1" 
                     x:Name="txtTestKitFolder"
                     Style="{StaticResource InputTextBox}"
                     IsReadOnly="True"/>
            <Button Grid.Row="2" Grid.Column="2" 
                    Content="Browse..." 
                    Style="{StaticResource BrowseButton}"
                    Click="BrowseTestKitFolder_Click"/>
            
            <!-- Save Results Folder -->
            <TextBlock Grid.Row="4" Grid.Column="0" 
                       Text="Save Results To:" 
                       VerticalAlignment="Center" 
                       FontWeight="SemiBold"/>
            <TextBox Grid.Row="4" Grid.Column="1" 
                     x:Name="txtSaveFolder"
                     Style="{StaticResource InputTextBox}"
                     IsReadOnly="True"/>
            <Button Grid.Row="4" Grid.Column="2" 
                    Content="Browse..." 
                    Style="{StaticResource BrowseButton}"
                    Click="BrowseSaveFolder_Click"/>
            
            <!-- Client/Server Configuration -->
            <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" 
                    BorderBrush="#DDDDDD" BorderThickness="1" 
                    CornerRadius="5" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" 
                               Text="Project Configuration" 
                               FontWeight="Bold" 
                               FontSize="14"/>
                    
                    <!-- Helper Text -->
                    <TextBlock Grid.Row="2" 
                               TextWrapping="Wrap"
                               Foreground="#666666"
                               FontSize="11">
                        <Run Text="Enter project names for Question 1 as they appear in student submissions."/>
                        <LineBreak/>
                        <Run Text="Examples: Q1, Project11, Project12, Q11, Q12 (for client/server split)."/>
                        <LineBreak/>
                        <Run Text="If only one project is specified, toggles are not needed."/>
                        <LineBreak/>
                        <Run Text="If two projects are specified use toggles to indicate which is client and which is server."/>
                        <LineBreak/>
                        <Run Text="Project 2 refers to a second project for Question 1 (e.g., Q12 for client/server split), not Question 2." FontWeight="SemiBold" Foreground="#1976D2"/>
                        <LineBreak/>
                        <Run Text="Note: This system only grades Question 1. Q2, Q3, etc. are not supported." FontWeight="SemiBold" Foreground="#D32F2F"/>
                    </TextBlock>
                    
                    <!-- Project 1 -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Project 1:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" x:Name="txtProject1Name" Height="28" VerticalContentAlignment="Center" Padding="5,0" ToolTip="Enter project name (e.g., Q1, Project11)" TextChanged="ProjectName_TextChanged"/>
                        
                        <!-- Client/Server Toggles for Project 1 -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" x:Name="pnlProject1Role">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtProject1Name}" Value="">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtProject1Name}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <RadioButton x:Name="rbProject1Client" Content="Client" GroupName="Project1Role" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="rbProject1Server" Content="Server" GroupName="Project1Role" VerticalAlignment="Center" IsChecked="True"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Project 2 -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Project 2:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" x:Name="txtProject2Name" Height="28" VerticalContentAlignment="Center" Padding="5,0" ToolTip="Enter project name (e.g., Q2, Project12)" TextChanged="ProjectName_TextChanged"/>
                        
                        <!-- Client/Server Toggles for Project 2 -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" x:Name="pnlProject2Role">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtProject2Name}" Value="">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtProject2Name}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <RadioButton x:Name="rbProject2Client" Content="Client" GroupName="Project2Role" Margin="0,0,10,0" VerticalAlignment="Center" IsChecked="True"/>
                            <RadioButton x:Name="rbProject2Server" Content="Server" GroupName="Project2Role" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Footer with Start Button -->
        <Border Grid.Row="2" Background="#F0F0F0" Padding="20" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="txtValidation" Grid.Column="0" Foreground="Red" VerticalAlignment="Center" TextWrapping="Wrap"/>
                
                <Button Grid.Column="1" x:Name="btnStartGrading" Content="▶ Start Grading" Background="#28A745" Foreground="White" FontWeight="Bold" Style="{StaticResource ActionButton}" Click="StartGrading_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
