<Window x:Class="SolutionGrader.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Auto Grading System - Setup" 
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    
    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="20">
            <StackPanel>
                <TextBlock Text="Auto Grading System" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="White"/>
                <TextBlock Text="Setup Configuration" 
                           FontSize="14" 
                           Foreground="#CCCCCC"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Configuration Form -->
        <Grid Grid.Row="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Submit Folder -->
            <TextBlock Grid.Row="0" Grid.Column="0" 
                       Text="Submit Folder:" 
                       VerticalAlignment="Center" 
                       FontWeight="SemiBold"/>
            <TextBox Grid.Row="0" Grid.Column="1" 
                     x:Name="txtSubmitFolder"
                     Style="{StaticResource InputTextBox}"
                     IsReadOnly="True"/>
            <Button Grid.Row="0" Grid.Column="2" 
                    Content="Browse..." 
                    Style="{StaticResource BrowseButton}"
                    Click="BrowseSubmitFolder_Click"/>
            
            <!-- Test Kit Folder -->
            <TextBlock Grid.Row="2" Grid.Column="0" 
                       Text="Test Kit Folder:" 
                       VerticalAlignment="Center" 
                       FontWeight="SemiBold"/>
            <TextBox Grid.Row="2" Grid.Column="1" 
                     x:Name="txtTestKitFolder"
                     Style="{StaticResource InputTextBox}"
                     IsReadOnly="True"/>
            <Button Grid.Row="2" Grid.Column="2" 
                    Content="Browse..." 
                    Style="{StaticResource BrowseButton}"
                    Click="BrowseTestKitFolder_Click"/>
            
            <!-- Save Results Folder -->
            <TextBlock Grid.Row="4" Grid.Column="0" 
                       Text="Save Results To:" 
                       VerticalAlignment="Center" 
                       FontWeight="SemiBold"/>
            <TextBox Grid.Row="4" Grid.Column="1" 
                     x:Name="txtSaveFolder"
                     Style="{StaticResource InputTextBox}"
                     IsReadOnly="True"/>
            <Button Grid.Row="4" Grid.Column="2" 
                    Content="Browse..." 
                    Style="{StaticResource BrowseButton}"
                    Click="BrowseSaveFolder_Click"/>
            
            <!-- Client/Server Configuration -->
            <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" 
                    BorderBrush="#DDDDDD" BorderThickness="1" 
                    CornerRadius="5" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
                               Text="Project Configuration" 
                               FontWeight="Bold" 
                               FontSize="14"
                               Margin="0,0,0,10"/>
                    
                    <!-- Has Client -->
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <CheckBox x:Name="chkHasClient" 
                                  Content="Has Client Component" 
                                  IsChecked="True"/>
                        <StackPanel Orientation="Horizontal" Margin="20,8,0,0">
                            <TextBlock Text="Client Project Name:" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"/>
                            <TextBox x:Name="txtClientProjectName" 
                                     Text="Project12" 
                                     Width="120" 
                                     Height="25"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Enter the client project name (e.g., Project12). The DLL with this name will be searched for."/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Has Server -->
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <CheckBox x:Name="chkHasServer" 
                                  Content="Has Server Component" 
                                  IsChecked="True"/>
                        <StackPanel Orientation="Horizontal" Margin="20,8,0,0">
                            <TextBlock Text="Server Project Name:" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"/>
                            <TextBox x:Name="txtServerProjectName" 
                                     Text="Project11" 
                                     Width="120" 
                                     Height="25"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Enter the server project name (e.g., Project11). The DLL with this name will be searched for."/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Info text about ports -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" 
                               Text="Note: Port configurations are read from each test kit's Environment.xlsx file."
                               FontStyle="Italic" 
                               Foreground="#666666"
                               FontSize="11"
                               Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Footer with Start Button -->
        <Border Grid.Row="2" Background="#F0F0F0" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="txtValidation" 
                           Grid.Column="0"
                           Foreground="Red" 
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
                
                <Button Grid.Column="1" 
                        x:Name="btnStartGrading"
                        Content="▶ Start Grading" 
                        Background="#28A745" 
                        Foreground="White"
                        FontWeight="Bold"
                        Style="{StaticResource ActionButton}"
                        Click="StartGrading_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
