<Window x:Class="SolutionGrader.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SolutionGrader.UI"
        xmlns:vm="clr-namespace:SolutionGrader.UI.ViewModels"
        mc:Ignorable="d"
        Title="Auto Grading System - Solution Grader" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <!-- Status to Color Converter -->
        <local:StatusToColorConverter x:Key="StatusToColorConverter" />
        
        <!-- Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header Section -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="15">
            <TextBlock Text="Auto Grading System" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="White"/>
        </Border>
        
        <!-- Configuration Section -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Submit Folder -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Submit Folder:" 
                           VerticalAlignment="Center" Margin="0,5,10,5" FontWeight="Bold"/>
                <TextBox Grid.Row="0" Grid.Column="1" 
                         Text="{Binding Configuration.SubmitFolderPath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" Margin="0,5"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." 
                        Command="{Binding BrowseSubmitFolderCommand}"
                        Style="{StaticResource ActionButton}"/>
                
                <!-- Test Kit Folder -->
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Test Kit Folder:" 
                           VerticalAlignment="Center" Margin="20,5,10,5" FontWeight="Bold"/>
                <TextBox Grid.Row="0" Grid.Column="4" 
                         Text="{Binding Configuration.TestKitFolderPath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" Margin="0,5"/>
                <Button Grid.Row="0" Grid.Column="5" Content="Browse..." 
                        Command="{Binding BrowseTestKitFolderCommand}"
                        Style="{StaticResource ActionButton}"/>
                
                <!-- Project Names Configuration -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,10,0,5">
                    <!-- Has Client Checkbox -->
                    <CheckBox Content="Has Client" 
                              IsChecked="{Binding Configuration.HasClient}" 
                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Client Project:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding Configuration.ClientProjectName, UpdateSourceTrigger=PropertyChanged}" 
                             Width="120" VerticalAlignment="Center"
                             IsEnabled="{Binding Configuration.HasClient}"/>
                    
                    <!-- Has Server Checkbox -->
                    <CheckBox Content="Has Server" 
                              IsChecked="{Binding Configuration.HasServer}" 
                              VerticalAlignment="Center" Margin="30,0,10,0"/>
                    <TextBlock Text="Server Project:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding Configuration.ServerProjectName, UpdateSourceTrigger=PropertyChanged}" 
                             Width="120" VerticalAlignment="Center"
                             IsEnabled="{Binding Configuration.HasServer}"/>
                    
                    <!-- Port Configuration -->
                    <TextBlock Text="Internal Port:" VerticalAlignment="Center" Margin="30,0,5,0"/>
                    <TextBox Text="{Binding Configuration.CodeContainerInternalPort, UpdateSourceTrigger=PropertyChanged}" 
                             Width="60" VerticalAlignment="Center"/>
                    
                    <TextBlock Text="Host Port:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <TextBox Text="{Binding Configuration.CodeContainerHostPort, UpdateSourceTrigger=PropertyChanged}" 
                             Width="60" VerticalAlignment="Center"/>
                    
                    <!-- Load Students Button -->
                    <Button Content="Load Students" 
                            Command="{Binding LoadStudentsCommand}"
                            Background="#007ACC" Foreground="White"
                            Style="{StaticResource ActionButton}" Margin="30,0,0,0"/>
                </StackPanel>
                
                <!-- Filter and Action Buttons -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Filter by Paper:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding PaperNumbers}" 
                              SelectedItem="{Binding SelectedPaperFilter}"
                              Width="80" VerticalAlignment="Center"/>
                    
                    <Button Content="▶ Start All" 
                            Command="{Binding StartGradingCommand}"
                            Background="#28A745" Foreground="White"
                            Style="{StaticResource ActionButton}" Margin="30,0,0,0"/>
                    
                    <Button Content="▶ Start Selected" 
                            Command="{Binding StartSelectedGradingCommand}"
                            Background="#17A2B8" Foreground="White"
                            Style="{StaticResource ActionButton}"/>
                    
                    <Button Content="⏸ Pause" 
                            Command="{Binding PauseGradingCommand}"
                            Background="#FFC107" Foreground="Black"
                            Style="{StaticResource ActionButton}"/>
                    
                    <Button Content="▶ Resume" 
                            Command="{Binding ResumeGradingCommand}"
                            Background="#20C997" Foreground="White"
                            Style="{StaticResource ActionButton}"/>
                    
                    <Button Content="↻ Reset All" 
                            Command="{Binding ResetAllCommand}"
                            Background="#DC3545" Foreground="White"
                            Style="{StaticResource ActionButton}" Margin="30,0,0,0"/>
                    
                    <Button Content="↻ Reset Selected" 
                            Command="{Binding ResetSelectedCommand}"
                            Background="#FD7E14" Foreground="White"
                            Style="{StaticResource ActionButton}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Students DataGrid -->
            <DataGrid Grid.Column="0" 
                      ItemsSource="{Binding Students}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      AlternatingRowBackground="#F8F8F8"
                      GridLinesVisibility="Horizontal"
                      Margin="10">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="✓" 
                                            Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                            Width="40"/>
                    <DataGridTextColumn Header="Student Code" 
                                        Binding="{Binding StudentCode}" 
                                        Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Paper" 
                                        Binding="{Binding PaperNo}" 
                                        Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Status" 
                                        Binding="{Binding StatusDisplay}" 
                                        Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Mark" 
                                        Binding="{Binding Mark, StringFormat=N1}" 
                                        Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Progress" 
                                        Binding="{Binding ProgressPercent, StringFormat={}{0}%}" 
                                        Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Start Time" 
                                        Binding="{Binding StartTime, StringFormat=HH:mm:ss}" 
                                        Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="End Time" 
                                        Binding="{Binding EndTime, StringFormat=HH:mm:ss}" 
                                        Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Duration" 
                                        Binding="{Binding Duration}" 
                                        Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Message" 
                                        Binding="{Binding StatusMessage}" 
                                        Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
                
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                <Setter Property="Background" Value="#D4EDDA"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                <Setter Property="Background" Value="#F8D7DA"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                <Setter Property="Background" Value="#FFF3CD"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Paused">
                                <Setter Property="Background" Value="#D1ECF1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
            
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
            
            <!-- Log Panel -->
            <Border Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,10,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#2D2D30" Padding="10">
                        <TextBlock Text="Grading Log" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    
                    <TextBox Grid.Row="1" 
                             Text="{Binding LogOutput, Mode=OneWay}"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="11"
                             Background="#1E1E1E"
                             Foreground="#DCDCDC"/>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#007ACC" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Foreground="White">
                    <Run Text="Current: "/>
                    <Run Text="{Binding SessionState.CurrentStudentCode, FallbackValue='-'}"/>
                </TextBlock>
                
                <TextBlock Grid.Column="1" Foreground="White" Margin="20,0">
                    <Run Text="Progress: "/>
                    <Run Text="{Binding SessionState.GradedStudentsDisplay, FallbackValue='0'}"/>
                    <Run Text="/"/>
                    <Run Text="{Binding SessionState.TotalStudentsDisplay, FallbackValue='0'}"/>
                    <Run Text=" ("/>
                    <Run Text="{Binding SessionState.OverallProgressDisplay, FallbackValue='0'}"/>
                    <Run Text="%)"/>
                </TextBlock>
                
                <TextBlock Grid.Column="2" Foreground="#90EE90" Margin="20,0">
                    <Run Text="Success: "/>
                    <Run Text="{Binding SessionState.SuccessCountDisplay, FallbackValue='0'}"/>
                </TextBlock>
                
                <TextBlock Grid.Column="3" Foreground="#FFB6C1" Margin="20,0">
                    <Run Text="Failed: "/>
                    <Run Text="{Binding SessionState.FailedCountDisplay, FallbackValue='0'}"/>
                </TextBlock>
                
                <TextBlock Grid.Column="4" Foreground="#FFFACD" Margin="20,0">
                    <Run Text="Not Run: "/>
                    <Run Text="{Binding SessionState.NotRunCountDisplay, FallbackValue='0'}"/>
                </TextBlock>
                
                <TextBlock Grid.Column="5" Foreground="White" Margin="20,0,0,0">
                    <Run Text="Elapsed: "/>
                    <Run Text="{Binding SessionState.ElapsedTime, FallbackValue='-'}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
