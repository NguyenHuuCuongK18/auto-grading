<Window x:Class="SolutionGrader.UI.GradingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SolutionGrader.UI"
        mc:Ignorable="d"
        Title="Auto Grading System - Grading" 
        Height="850" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Status to Color Converter -->
        <local:StatusToColorConverter x:Key="StatusToColorConverter" />

        <!-- Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Controls -->
            <RowDefinition Height="*"/>
            <!-- 2: DataGrid (Fills remaining space) -->
            <RowDefinition Height="5"/>
            <!-- 3: Spacer -->
            <RowDefinition Height="200"/>
            <!-- 4: Log Area -->
            <RowDefinition Height="Auto"/>
            <!-- 5: Status Bar -->
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Auto Grading System" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="White"
                               Margin="0,0,15,0"/>
                    <Border Background="#3E3E42" CornerRadius="3" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="txtConfigInfo" 
                                   Text="Config Loaded"
                                   Foreground="#DDDDDD"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="← Back to Setup"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="#666666"
                        BorderThickness="1"
                        Padding="12,6"
                        Cursor="Hand"
                        Click="BackToSetup_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Control Section: wrapped in ScrollViewer and stacked vertically to avoid overlap -->
        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="10" Background="#FFFFFF">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Section 1: Student Selection (full width) -->
                    <Border BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4" Padding="10" Background="#FAFAFA" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="STUDENT SELECTION" 
                                       FontWeight="Bold"
                                       FontSize="11"
                                       Foreground="#6C757D"
                                       Margin="0,0,0,8"/>

                            <WrapPanel VerticalAlignment="Center">
                                <!-- Index Range -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                                    <TextBlock Text="Index:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#444"/>
                                    <TextBox x:Name="txtSelectStartIndex" Width="60" Height="26" VerticalContentAlignment="Center" TextAlignment="Center" Text="1"/>
                                    <TextBlock Text="-" VerticalAlignment="Center" Margin="5,0"/>
                                    <TextBox x:Name="txtSelectEndIndex" Width="60" Height="26" VerticalContentAlignment="Center" TextAlignment="Center" Text="-1"/>
                                    <Button x:Name="btnApplyIndexSelection" Content="Apply" Margin="5,0,0,0" Padding="8,0" Height="26" Click="ApplyIndexSelection_Click"/>
                                </StackPanel>

                                <Border Width="1" Height="20" Background="#DDDDDD" Margin="0,0,15,0"/>

                                <!-- Paper Selection -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                                    <TextBlock Text="Paper:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#444"/>
                                    <ComboBox x:Name="cmbPaperSelection" Width="120" Height="26" VerticalContentAlignment="Center" SelectionChanged="PaperSelection_SelectionChanged"/>
                                </StackPanel>

                                <Border Width="1" Height="20" Background="#DDDDDD" Margin="0,0,15,0"/>

                                <!-- Buttons -->
                                <Button x:Name="btnSelectAll" Content="All" Height="26" Padding="10,0" Margin="0,0,5,0" Click="SelectAll_Click"/>
                                <Button x:Name="btnUnselectAll" Content="None" Height="26" Padding="10,0" Click="UnselectAll_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section 2: Grading Actions (full width) -->
                    <Border BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4" Padding="10" Background="#FAFAFA">
                        <StackPanel>
                            <TextBlock Text="GRADING ACTIONS" 
                                       FontWeight="Bold"
                                       FontSize="11"
                                       Foreground="#6C757D"
                                       Margin="0,0,0,8"/>

                            <WrapPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                                    <TextBlock Text="Batch:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#444"/>
                                    <TextBox x:Name="txtMaxParallelStudents" Width="60" Height="26" VerticalContentAlignment="Center" TextAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>

                                <Border Width="1" Height="20" Background="#DDDDDD" Margin="0,0,15,0"/>
                                
                                <!-- DLL Modification Fallback Checkbox -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                                    <CheckBox x:Name="chkUseDllModFallback" 
                                              VerticalAlignment="Center" 
                                              Margin="0,0,5,0"
                                              ToolTip="Enable DLL modification fallback when appsettings.json is missing"/>
                                    <TextBlock Text="DLL modification fallback" 
                                               VerticalAlignment="Center" 
                                               Foreground="#444"
                                               ToolTip="When enabled, the system will patch DLL files directly if appsettings.json is not found"/>
                                </StackPanel>

                                <Border Width="1" Height="20" Background="#DDDDDD" Margin="0,0,15,0"/>

                                <!-- Start Buttons -->
                                <Button x:Name="btnStartAll" Content="▶ Start All" Background="#28A745" Foreground="White" Padding="12,4" Margin="0,0,5,0" Height="26" Click="StartAll_Click" BorderThickness="0"/>
                                <Button x:Name="btnStartSelected" Content="▶ Start Selected" Background="#17A2B8" Foreground="White" Padding="12,4" Margin="0,0,15,0" Height="26" Click="StartSelected_Click" BorderThickness="0"/>

                                <Border Width="1" Height="20" Background="#DDDDDD" Margin="0,0,15,0"/>

                                <!-- Control Buttons -->
                                <Button x:Name="btnPause" Content="⏸" ToolTip="Pause" Background="#FFC107" Padding="10,4" Margin="0,0,5,0" Height="26" Click="Pause_Click" BorderThickness="0"/>
                                <Button x:Name="btnResume" Content="▶" ToolTip="Resume" Background="#20C997" Foreground="White" Padding="10,4" Margin="0,0,15,0" Height="26" Click="Resume_Click" BorderThickness="0"/>

                                <Border Width="1" Height="20" Background="#DDDDDD" Margin="0,0,15,0"/>

                                <!-- Reset Buttons -->
                                <Button x:Name="btnResetAll" Content="Reset All" Background="#DC3545" Foreground="White" Padding="10,4" Margin="0,0,5,0" Height="26" Click="ResetAll_Click" BorderThickness="0"/>
                                <Button x:Name="btnResetSelected" Content="Reset Selected" Background="#FD7E14" Foreground="White" Padding="10,4" Height="26" Click="ResetSelected_Click" BorderThickness="0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main Content Area: DataGrid -->
        <!-- Removed bottom margin hack, now handled by Grid.Row="2" height="*" -->
        <Grid Grid.Row="2" Margin="10">
            <DataGrid x:Name="dgStudents"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      AlternatingRowBackground="#FAFAFA"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEEEEE"
                      VerticalGridLinesBrush="Transparent"
                      BorderThickness="1"
                      BorderBrush="#DDDDDD"
                      RowHeight="32"
                      FontSize="13"
                      EnableColumnVirtualization="True"
                      EnableRowVirtualization="True"
                      SelectionChanged="dgStudents_SelectionChanged">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Background" Value="#F8F9FA"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="#DDDDDD"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="5,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Select" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Student Code" Binding="{Binding StudentCode}" Width="120" IsReadOnly="True" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Paper" Binding="{Binding PaperNo}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Mark" Binding="{Binding Mark, StringFormat=N1}" Width="60" IsReadOnly="True" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Max" Binding="{Binding MaxMark, StringFormat=N1}" Width="50" IsReadOnly="True" Foreground="#888"/>
                    <DataGridTextColumn Header="Progress" Binding="{Binding ProgressPercent, StringFormat={}{0}%}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Start" Binding="{Binding StartTime, StringFormat=HH:mm:ss}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="End" Binding="{Binding EndTime, StringFormat=HH:mm:ss}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding StatusMessage}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                <Setter Property="Background" Value="#E8F5E9"/>
                                <!-- Lighter Green -->
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                <Setter Property="Background" Value="#FFEBEE"/>
                                <!-- Lighter Red -->
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                <Setter Property="Background" Value="#FFF8E1"/>
                                <!-- Lighter Yellow -->
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Paused">
                                <Setter Property="Background" Value="#E1F5FE"/>
                                <!-- Lighter Blue -->
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Not_Run">
                                <Setter Property="Background" Value="#FFFFFF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Grid>

        <!-- Grid Splitter (Optional resize handle) -->
        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="#DDDDDD"/>

        <!-- Grading Log -->
        <!-- Fixed layout: No negative margins -->
        <Border Grid.Row="4" BorderBrush="#CCCCCC" BorderThickness="1" Background="White" Margin="10,0,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F1F1F1" Padding="10,6" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Grading Log" FontWeight="Bold" Foreground="#333333"/>
                        <TextBlock Text="(Output from execution)" Margin="10,0,0,0" Foreground="#888888" FontStyle="Italic"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="txtLog"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="5"
                             BorderThickness="0"
                             Background="#1E1E1E"
                             Foreground="#DCDCDC"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="5" Background="#007ACC" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Foreground="White" x:Name="txtCurrentStudent" TextTrimming="CharacterEllipsis">
                    <Run Text="Current: " FontWeight="SemiBold"/>
                    <Run x:Name="runCurrentStudent" Text="-"/>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0">
                    <TextBlock Foreground="White"><Run Text="Progress: "/></TextBlock>
                    <TextBlock Foreground="White" FontWeight="Bold">
                        <Run x:Name="runGraded" Text="0"/>
                        <Run Text="/"/>
                        <Run x:Name="runTotal" Text="0"/>
                    </TextBlock>
                    <TextBlock Foreground="#E0E0E0" Margin="5,0,0,0">
                        <Run Text="("/>
                        <Run x:Name="runPercent" Text="0"/>
                        <Run Text="%)"/>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="2" Foreground="#90EE90" Margin="20,0">
                    <Run Text="Success: "/>
                    <Run x:Name="runSuccess" Text="0" FontWeight="Bold"/>
                </TextBlock>

                <TextBlock Grid.Column="3" Foreground="#FFB6C1" Margin="20,0">
                    <Run Text="Failed: "/>
                    <Run x:Name="runFailed" Text="0" FontWeight="Bold"/>
                </TextBlock>

                <TextBlock Grid.Column="4" Foreground="#FFFACD" Margin="20,0">
                    <Run Text="Not Run: "/>
                    <Run x:Name="runNotRun" Text="0" FontWeight="Bold"/>
                </TextBlock>

                <TextBlock Grid.Column="5" Foreground="White" Margin="20,0,0,0">
                    <Run Text="Elapsed: "/>
                    <Run x:Name="runElapsed" Text="-" FontWeight="Bold"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>