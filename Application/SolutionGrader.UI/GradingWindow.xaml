<Window x:Class="SolutionGrader.UI.GradingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SolutionGrader.UI"
        mc:Ignorable="d"
        Title="Auto Grading System - Grading" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    
    <Window.Resources>
        <!-- Status to Color Converter -->
        <local:StatusToColorConverter x:Key="StatusToColorConverter" />
        
        <!-- Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header Section -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Auto Grading System" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock x:Name="txtConfigInfo" 
                               Foreground="#AAAAAA"
                               FontSize="11"
                               Margin="0,5,0,0"/>
                </StackPanel>
                
                <Button Grid.Column="1" 
                        Content="← Back to Setup"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="#666666"
                        Padding="15,8"
                        Click="BackToSetup_Click"/>
            </Grid>
        </Border>
        
        <!-- Control Section -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="15">
            <StackPanel Orientation="Horizontal">
                <!-- Paper Selection - Selecting a paper will select all students with that paper number -->
                <TextBlock Text="Select by Paper:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbPaperSelection" 
                          Width="100" 
                          VerticalAlignment="Center"
                          SelectionChanged="PaperSelection_SelectionChanged"
                          ToolTip="Select a paper to select all students with that paper number"/>
                
                <!-- Select/Unselect All Buttons -->
                <Button x:Name="btnSelectAll" 
                        Content="☑ Select All" 
                        Background="#6C757D" Foreground="White"
                        Style="{StaticResource ActionButton}" 
                        Margin="10,0,0,0"
                        Click="SelectAll_Click"
                        ToolTip="Select all visible students"/>
                
                <Button x:Name="btnUnselectAll" 
                        Content="☐ Unselect All" 
                        Background="#6C757D" Foreground="White"
                        Style="{StaticResource ActionButton}"
                        Click="UnselectAll_Click"
                        ToolTip="Unselect all students"/>
                
                <Button x:Name="btnStartAll" 
                        Content="▶ Start All" 
                        Background="#28A745" Foreground="White"
                        Style="{StaticResource ActionButton}" 
                        Margin="30,0,0,0"
                        Click="StartAll_Click"
                        ToolTip="Start grading all students"/>
                
                <Button x:Name="btnStartSelected" 
                        Content="▶ Start Selected" 
                        Background="#17A2B8" Foreground="White"
                        Style="{StaticResource ActionButton}"
                        Click="StartSelected_Click"
                        ToolTip="Start grading only selected students"/>
                
                <Button x:Name="btnPause" 
                        Content="⏸ Pause" 
                        Background="#FFC107" Foreground="Black"
                        Style="{StaticResource ActionButton}"
                        Click="Pause_Click"
                        ToolTip="Pause the grading process"/>
                
                <Button x:Name="btnResume" 
                        Content="▶ Resume" 
                        Background="#20C997" Foreground="White"
                        Style="{StaticResource ActionButton}"
                        Click="Resume_Click"
                        ToolTip="Resume paused grading"/>
                
                <Button x:Name="btnResetAll" 
                        Content="↻ Reset All" 
                        Background="#DC3545" Foreground="White"
                        Style="{StaticResource ActionButton}" 
                        Margin="30,0,0,0"
                        Click="ResetAll_Click"
                        ToolTip="Reset all student grading statuses"/>
                
                <Button x:Name="btnResetSelected" 
                        Content="↻ Reset Selected" 
                        Background="#FD7E14" Foreground="White"
                        Style="{StaticResource ActionButton}"
                        Click="ResetSelected_Click"
                        ToolTip="Reset selected student grading statuses"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Students DataGrid -->
            <DataGrid Grid.Column="0" 
                      x:Name="dgStudents"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      AlternatingRowBackground="#F8F8F8"
                      GridLinesVisibility="Horizontal"
                      Margin="10">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="✓" 
                                            Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                            Width="40"/>
                    <DataGridTextColumn Header="Student Code" 
                                        Binding="{Binding StudentCode}" 
                                        Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Paper" 
                                        Binding="{Binding PaperNo}" 
                                        Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Status" 
                                        Binding="{Binding StatusDisplay}" 
                                        Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Mark" 
                                        Binding="{Binding Mark, StringFormat=N1}" 
                                        Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Max" 
                                        Binding="{Binding MaxMark, StringFormat=N1}" 
                                        Width="50" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Progress" 
                                        Binding="{Binding ProgressPercent, StringFormat={}{0}%}" 
                                        Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Start Time" 
                                        Binding="{Binding StartTime, StringFormat=HH:mm:ss}" 
                                        Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="End Time" 
                                        Binding="{Binding EndTime, StringFormat=HH:mm:ss}" 
                                        Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Duration" 
                                        Binding="{Binding Duration}" 
                                        Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Message" 
                                        Binding="{Binding StatusMessage}" 
                                        Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
                
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                <Setter Property="Background" Value="#D4EDDA"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                <Setter Property="Background" Value="#F8D7DA"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                <Setter Property="Background" Value="#FFF3CD"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Paused">
                                <Setter Property="Background" Value="#D1ECF1"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Not_Run">
                                <Setter Property="Background" Value="#FFFFFF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
            
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
            
            <!-- Log Panel -->
            <Border Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,10,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#2D2D30" Padding="10">
                        <TextBlock Text="Grading Log" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    
                    <TextBox Grid.Row="1" 
                             x:Name="txtLog"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="11"
                             Background="#1E1E1E"
                             Foreground="#DCDCDC"/>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#007ACC" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Foreground="White" x:Name="txtCurrentStudent">
                    <Run Text="Current: "/>
                    <Run x:Name="runCurrentStudent" Text="-"/>
                </TextBlock>
                
                <TextBlock Grid.Column="1" Foreground="White" Margin="20,0">
                    <Run Text="Progress: "/>
                    <Run x:Name="runGraded" Text="0"/>
                    <Run Text="/"/>
                    <Run x:Name="runTotal" Text="0"/>
                    <Run Text=" ("/>
                    <Run x:Name="runPercent" Text="0"/>
                    <Run Text="%)"/>
                </TextBlock>
                
                <TextBlock Grid.Column="2" Foreground="#90EE90" Margin="20,0">
                    <Run Text="Success: "/>
                    <Run x:Name="runSuccess" Text="0"/>
                </TextBlock>
                
                <TextBlock Grid.Column="3" Foreground="#FFB6C1" Margin="20,0">
                    <Run Text="Failed: "/>
                    <Run x:Name="runFailed" Text="0"/>
                </TextBlock>
                
                <TextBlock Grid.Column="4" Foreground="#FFFACD" Margin="20,0">
                    <Run Text="Not Run: "/>
                    <Run x:Name="runNotRun" Text="0"/>
                </TextBlock>
                
                <TextBlock Grid.Column="5" Foreground="White" Margin="20,0,0,0">
                    <Run Text="Elapsed: "/>
                    <Run x:Name="runElapsed" Text="-"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
