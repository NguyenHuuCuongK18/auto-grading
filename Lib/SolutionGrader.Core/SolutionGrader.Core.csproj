<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-target to support both cross-platform and Windows-specific builds -->
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>b0bfe8b8-32c6-46a8-b6f5-b5763b68d328</UserSecretsId>
    <!-- 
      CS0618: Suppress obsolete member warnings - these are intentionally used for 
      backward compatibility with older test kit formats (e.g., OC_, OS_ prefixes).
    -->
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>
  
  <!-- Windows-specific properties -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="EPPlus" Version="8.3.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.0" />
    <PackageReference Include="PacketDotNet" Version="1.4.8" />
    <PackageReference Include="SharpPcap" Version="6.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\EnvironmentBuilder\EnvironmentBuilder.csproj" />
    <ProjectReference Include="..\FileMaster\FileMaster.csproj" />
    <ProjectReference Include="..\ProcessLauncher\ProcessLauncher.csproj" />
    <ProjectReference Include="..\DllMod\DllMod.csproj" />
  </ItemGroup>
</Project>
