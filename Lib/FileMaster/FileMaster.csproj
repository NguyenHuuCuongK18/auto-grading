<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target to support cross-platform builds -->
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Nullable disabled - file handling utilities with runtime-validated data -->
    <Nullable>disable</Nullable>
  </PropertyGroup>
  
  <!-- Windows-specific properties -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- DotNetZip removed due to NU1903 vulnerability - replaced with System.IO.Compression -->
    <PackageReference Include="EPPlus" Version="8.3.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\EnvironmentBuilder\EnvironmentBuilder.csproj" />
  </ItemGroup>

</Project>
