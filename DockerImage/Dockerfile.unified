# Auto-Grading Unified Container Image
# Image: fptuxaes/aes-dotnet8-console:latest
# 
# This image runs both client and server processes in a single container.
# Processes communicate via localhost (127.0.0.1) to eliminate proxy behavior.
# Supervisord manages process lifecycle based on test case actions.
#
# Build Command:
#   docker build -t fptuxaes/aes-dotnet8-console:latest -f DockerImage/Dockerfile.unified DockerImage/
#
# Push Command (if needed):
#   docker push fptuxaes/aes-dotnet8-console:latest

FROM mcr.microsoft.com/dotnet/sdk:8.0

# Install supervisord for process management
# Install dependencies with retry logic to handle transient network errors
RUN apt-get update && \
    for i in $(seq 1 3); do \
        apt-get install -y supervisor netcat-openbsd procps && break || sleep 5; \
    done && \
    rm -rf /var/lib/apt/lists/*

# Create directory structure
# /apps/server - Server DLLs, appsettings, and per-stage logs (server-stage-N.log)
# /apps/client - Client DLLs, appsettings, and per-stage logs (client-stage-N.log)
# /scripts - Control scripts for supervisorctl
RUN mkdir -p /apps/server /apps/client /scripts

# Copy supervisord configuration
COPY supervisord-unified.conf /etc/supervisor/conf.d/supervisord.conf

# Copy control script and entrypoint
COPY unified-control.sh /scripts/unified-control.sh
COPY unified-entrypoint.sh /scripts/unified-entrypoint.sh
RUN chmod +x /scripts/unified-control.sh /scripts/unified-entrypoint.sh

# Set environment variables for .NET
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV DOTNET_SYSTEM_CONSOLE_UNBUFFERED=1

# Expose supervisord HTTP interface (internal only)
EXPOSE 9001

# Set working directory
WORKDIR /apps

# Use custom entrypoint that sets up named pipe BEFORE starting Supervisord
# This ensures the pipe and keeper are ready before any client process starts
# Eliminates the race condition where client starts before writer is established
ENTRYPOINT ["/scripts/unified-entrypoint.sh"]
