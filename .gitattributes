# Auto Grading System - Git Attributes Configuration
# This file ensures proper line endings across different operating systems

# Default behavior: Use auto detection for text files
# Let Git determine which files are text and handle line endings appropriately
* text=auto

# Shell scripts MUST use LF line endings (Unix/Linux style)
# Windows CRLF line endings cause "no such file or directory" errors in Docker containers
*.sh text eol=lf

# Dockerfile line endings
Dockerfile* text eol=lf

# Configuration files
*.conf text eol=lf
*.config text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Source code files - use LF
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.json text eol=lf
*.xml text eol=lf

# Markdown and documentation - use LF
*.md text eol=lf
*.txt text eol=lf

# Excel files are binary
*.xlsx binary
*.xls binary

# Image files are binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Compressed files are binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary

# DLL and executable files are binary
*.dll binary
*.exe binary
*.so binary
